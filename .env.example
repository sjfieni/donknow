# Set actual hostname after obtaining a server and domain. Never commit .env.
APP_DOMAIN=
PUBLIC_ORIGIN=
# Resend: verified sender and a secure API key (enter values in server settings).
MAIL_FROM=
MAIL_API_KEY=
# Register each provider's OAuth app; exact callback paths are in docs/operations.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
# For proxy-backed secrets use the opaque base64(client-id:client-secret) value
# as NOTION_BASIC_AUTH. A normal deployment may use the raw client secret instead.
NOTION_BASIC_AUTH=
NOTION_CLIENT_SECRET=
# Optional base64 encoding of a 32-byte encryption key. Otherwise .token-key is
# generated in DATA_DIR. Keep the original key securely for disaster recovery.
INTEGRATION_TOKEN_KEY=
# Optional offsite backups. With no bucket, verified backups remain local.
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Free Render + Turso: set STORE_DRIVER=turso. No local fallback is permitted.
STORE_DRIVER=sqlite
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Stable random secret; Render generates this once. Preserve it across redeploys.
# Do not set both seed and INTEGRATION_TOKEN_KEY; the explicit key takes precedence.
INTEGRATION_KEY_SEED=
